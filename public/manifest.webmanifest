{
  "name": "AiVoid",
  "short_name": "AiVoid",
  "description": "Remove AI tags, Content Credentials and other metadata from images, right in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
